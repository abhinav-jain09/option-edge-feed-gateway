<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>app</groupId>
    <artifactId>options-edge-feed-gateway</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>OptionsEdge Feed Gateway</name>

    <properties>
        <java.version>21</java.version>
        <kafka.version>4.1.0</kafka.version>
        <confluent.version>8.2.1</confluent.version>
        <options-edge-contracts.version>0.1.0-SNAPSHOT</options-edge-contracts.version>
        <postgresql.version>42.7.8</postgresql.version>
        <!-- Override Spring Boot's managed 1.21.0: Docker Engine 29 removed the older Engine API
             versions that 1.21.0's docker-java client negotiates, so it cannot reach a local daemon. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          Testcontainers: the partition-expansion behaviour this project depends on lives in the Kafka
          CLIENT contract, not in our code — assign() preserving positions, partitionsFor() answering from
          a cache bounded by metadata.max.age.ms, a grown partition starting empty. Mocks cannot falsify
          any of those, so they are proven against a real broker. Test scope only.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.optionsedge</groupId>
            <artifactId>options-edge-contracts</artifactId>
            <version>${options-edge-contracts.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!--
          Keycloak JWT decoding for the WebSocket handshake. We deliberately depend ONLY on
          spring-security-oauth2-jose (NimbusJwtDecoder + JWT validators) and NOT on
          spring-security-oauth2-resource-server: the latter drags in spring-security-web, which trips
          Spring Boot's servlet security auto-config and would lock down every existing gateway endpoint
          behind a generated password. The handshake interceptor is our only enforcement point.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
            <version>${confluent.version}</version>
        </dependency>
        <dependency>
            <!-- JOSE/JWT verification against Keycloak JWKS (OE-DDD-001 §5.3) -->
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>9.40</version>
        </dependency>
        <dependency>
            <!-- Redis-backed single-use WS ticket store (OE-DDD-001 §5.3/§6.5); version via Spring Boot BOM -->
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <!--
          FLOW-EXPLORER-OPTION-CHAIN §6: read-only Postgres access for GET /api/pin-flow. We add
          ONLY the JDBC driver + HikariCP pool (both constructed manually behind @ConditionalOnProperty
          in PinFlowDataSourceConfig) and deliberately do NOT add spring-boot-starter-jdbc: that starter
          activates DataSourceAutoConfiguration, which would try to build (and, with a health/actuator
          probe, validate) a DataSource at boot — the gateway MUST start fine with NO database (§6.3).
          HikariCP's version is managed by the Spring Boot BOM; postgresql pinned via the property above.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
