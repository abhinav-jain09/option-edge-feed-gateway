{
  "type": "record",
  "name": "StructureToolsSet",
  "namespace": "com.optionsedge.contracts.marketstructure.tools",
  "doc": "market-structure structure tools, one record per timeframe per fold",
  "fields": [
    {
      "name": "schemaVersion",
      "type": "int"
    },
    {
      "name": "service",
      "type": "string"
    },
    {
      "name": "state",
      "type": {
        "type": "enum",
        "name": "SetState",
        "namespace": "com.optionsedge.contracts.marketstructure.tools",
        "symbols": [
          "OK",
          "UNAVAILABLE"
        ],
        "doc": "set state"
      }
    },
    {
      "name": "unavailableReason",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "UnavailableReason",
          "namespace": "com.optionsedge.contracts.marketstructure.tools",
          "symbols": [
            "NOT_READY",
            "SESSION_FATAL",
            "QUARANTINE",
            "OVERSIZED",
            "PARAMETER_SET_CHANGED",
            "DECISION_SLOT_PLACEHOLDER",
            "FOLD_FAILURE"
          ],
          "doc": "why a set carries no objects"
        }
      ],
      "default": null
    },
    {
      "name": "sessionDate",
      "type": "string"
    },
    {
      "name": "scheduleId",
      "type": "string"
    },
    {
      "name": "timeframe",
      "type": {
        "type": "enum",
        "name": "Timeframe",
        "namespace": "com.optionsedge.contracts.marketstructure.tools",
        "symbols": [
          "M1",
          "M5",
          "M15",
          "H1",
          "H4"
        ],
        "doc": "H1 and H4 are reserved for a multi-session host and are never published by this host"
      }
    },
    {
      "name": "asOfMs",
      "type": "long"
    },
    {
      "name": "decisionOrdinal",
      "type": "int"
    },
    {
      "name": "foldOrdinal",
      "type": "int"
    },
    {
      "name": "rthOpenMs",
      "type": "long"
    },
    {
      "name": "slotMs",
      "type": "long"
    },
    {
      "name": "parameterSetHash",
      "type": "string"
    },
    {
      "name": "dictionaryVersion",
      "type": "int"
    },
    {
      "name": "volumeState",
      "type": {
        "type": "enum",
        "name": "VolumeState",
        "namespace": "com.optionsedge.contracts.marketstructure.tools",
        "symbols": [
          "AVAILABLE",
          "UNAVAILABLE"
        ],
        "doc": "whether the bar series carries volume"
      }
    },
    {
      "name": "maxObjects",
      "type": "int"
    },
    {
      "name": "droppedObjects",
      "type": "int"
    },
    {
      "name": "objects",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "StructureObject",
          "namespace": "com.optionsedge.contracts.marketstructure.tools",
          "doc": "one drawable structure object",
          "fields": [
            {
              "name": "objectId",
              "type": "string"
            },
            {
              "name": "tool",
              "type": "string",
              "doc": "dictionary TOOLS"
            },
            {
              "name": "subtype",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "degree",
              "type": "int"
            },
            {
              "name": "orientation",
              "type": {
                "type": "enum",
                "name": "Orientation",
                "namespace": "com.optionsedge.contracts.marketstructure.tools",
                "symbols": [
                  "RISING",
                  "FALLING",
                  "FLAT",
                  "TOP",
                  "BOTTOM",
                  "UP",
                  "DOWN",
                  "NONE"
                ],
                "doc": "geometry orientation only; never a forecast"
              }
            },
            {
              "name": "role",
              "type": {
                "type": "enum",
                "name": "Role",
                "namespace": "com.optionsedge.contracts.marketstructure.tools",
                "symbols": [
                  "SUPPORT",
                  "RESISTANCE",
                  "NEUTRAL",
                  "NONE"
                ],
                "doc": "role of a level against the latest close"
              }
            },
            {
              "name": "phase",
              "type": "string",
              "doc": "per-tool phase dictionary"
            },
            {
              "name": "firstOrdinal",
              "type": "int"
            },
            {
              "name": "lastOrdinal",
              "type": "int"
            },
            {
              "name": "revision",
              "type": "int"
            },
            {
              "name": "anchors",
              "type": {
                "type": "array",
                "items": {
                  "type": "record",
                  "name": "Anchor",
                  "namespace": "com.optionsedge.contracts.marketstructure.tools",
                  "doc": "a point of the geometry: bar ordinal and price in cents",
                  "fields": [
                    {
                      "name": "ordinal",
                      "type": "int"
                    },
                    {
                      "name": "priceCents",
                      "type": "long"
                    },
                    {
                      "name": "kind",
                      "type": "string",
                      "doc": "dictionary ANCHOR_KINDS"
                    },
                    {
                      "name": "pivotId",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null
                    },
                    {
                      "name": "settled",
                      "type": "boolean"
                    }
                  ]
                }
              }
            },
            {
              "name": "primitives",
              "type": {
                "type": "array",
                "items": {
                  "type": "record",
                  "name": "Primitive",
                  "namespace": "com.optionsedge.contracts.marketstructure.tools",
                  "doc": "one drawing primitive; x in bar ordinals, y in cents",
                  "fields": [
                    {
                      "name": "kind",
                      "type": {
                        "type": "enum",
                        "name": "PrimitiveKind",
                        "namespace": "com.optionsedge.contracts.marketstructure.tools",
                        "symbols": [
                          "SEGMENT",
                          "RAY",
                          "HORIZONTAL",
                          "BAND",
                          "BOX",
                          "MARKER"
                        ],
                        "doc": "drawing primitive"
                      }
                    },
                    {
                      "name": "x1",
                      "type": "int"
                    },
                    {
                      "name": "y1",
                      "type": "long"
                    },
                    {
                      "name": "x2",
                      "type": [
                        "null",
                        "int"
                      ],
                      "default": null
                    },
                    {
                      "name": "y2",
                      "type": [
                        "null",
                        "long"
                      ],
                      "default": null
                    },
                    {
                      "name": "y1b",
                      "type": [
                        "null",
                        "long"
                      ],
                      "default": null,
                      "doc": "BAND: second line y at x1"
                    },
                    {
                      "name": "y2b",
                      "type": [
                        "null",
                        "long"
                      ],
                      "default": null,
                      "doc": "BAND: second line y at x2"
                    },
                    {
                      "name": "extendRight",
                      "type": "boolean"
                    },
                    {
                      "name": "style",
                      "type": {
                        "type": "enum",
                        "name": "Style",
                        "namespace": "com.optionsedge.contracts.marketstructure.tools",
                        "symbols": [
                          "SOLID",
                          "DASHED",
                          "DOTTED"
                        ],
                        "doc": "line style"
                      }
                    },
                    {
                      "name": "emphasis",
                      "type": {
                        "type": "enum",
                        "name": "Emphasis",
                        "namespace": "com.optionsedge.contracts.marketstructure.tools",
                        "symbols": [
                          "NORMAL",
                          "STRONG",
                          "DIM"
                        ],
                        "doc": "line emphasis"
                      }
                    },
                    {
                      "name": "glyph",
                      "type": [
                        "null",
                        {
                          "type": "enum",
                          "name": "Glyph",
                          "namespace": "com.optionsedge.contracts.marketstructure.tools",
                          "symbols": [
                            "UP_TRIANGLE",
                            "DOWN_TRIANGLE",
                            "CIRCLE",
                            "CROSS",
                            "DIAMOND"
                          ],
                          "doc": "marker glyph"
                        }
                      ],
                      "default": null
                    },
                    {
                      "name": "label",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null
                    }
                  ]
                }
              }
            },
            {
              "name": "measures",
              "type": {
                "type": "array",
                "items": {
                  "type": "record",
                  "name": "Measure",
                  "namespace": "com.optionsedge.contracts.marketstructure.tools",
                  "doc": "one measured number; value null means not evaluable and reason says why",
                  "fields": [
                    {
                      "name": "key",
                      "type": "string",
                      "doc": "dictionary MEASURES"
                    },
                    {
                      "name": "value",
                      "type": [
                        "null",
                        "long"
                      ],
                      "default": null
                    },
                    {
                      "name": "reason",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null
                    }
                  ]
                }
              }
            },
            {
              "name": "events",
              "type": {
                "type": "array",
                "items": {
                  "type": "record",
                  "name": "ObjectEvent",
                  "namespace": "com.optionsedge.contracts.marketstructure.tools",
                  "doc": "one dated event of an object",
                  "fields": [
                    {
                      "name": "kind",
                      "type": "string",
                      "doc": "dictionary EVENT_KINDS"
                    },
                    {
                      "name": "ordinal",
                      "type": "int"
                    },
                    {
                      "name": "priceCents",
                      "type": "long"
                    }
                  ]
                }
              }
            },
            {
              "name": "flags",
              "type": {
                "type": "array",
                "items": "string"
              }
            },
            {
              "name": "linkedObjectIds",
              "type": {
                "type": "array",
                "items": "string"
              }
            },
            {
              "name": "meaning",
              "type": "string"
            },
            {
              "name": "bookRef",
              "type": "string"
            },
            {
              "name": "displayUntilOrdinal",
              "type": "int"
            },
            {
              "name": "calibration",
              "type": {
                "type": "enum",
                "name": "CalibrationState",
                "namespace": "com.optionsedge.contracts.marketstructure.tools",
                "symbols": [
                  "UNVALIDATED",
                  "VALIDATED"
                ],
                "doc": "VALIDATED when a stored validation result exists for the running parameter set (the measured result is in calibrationState, measuredEdge and evidence); UNVALIDATED only for a parameter set that was not measured. The enum cannot gain a symbol under FULL compatibility."
              }
            },
            {
              "name": "calibrationState",
              "type": [
                "null",
                "string"
              ],
              "default": null,
              "doc": "CALIBRATED (the running parameterSetHash is the one measured) or NOT_CALIBRATED; null only in a record written before this version"
            },
            {
              "name": "validationState",
              "type": [
                "null",
                "string"
              ],
              "default": null,
              "doc": "MEASURED when the validation fold was measured once under the running parameter set, else NOT_MEASURED; null only in a record written before this version"
            },
            {
              "name": "measuredEdge",
              "type": [
                "null",
                "string"
              ],
              "default": null,
              "doc": "NONE, POSITIVE, NOT_TESTABLE or EXACT_CONSTRUCT; null iff not CALIBRATED"
            },
            {
              "name": "evidence",
              "type": [
                "null",
                {
                  "type": "record",
                  "name": "Evidence",
                  "namespace": "com.optionsedge.contracts.marketstructure.tools",
                  "doc": "the measured result of the tool on this timeframe, from the pre-registered historical calibration",
                  "fields": [
                    {
                      "name": "validationResultId",
                      "type": "string"
                    },
                    {
                      "name": "claim",
                      "type": "string",
                      "doc": "the headline cell the numbers belong to, at most 40 characters"
                    },
                    {
                      "name": "n",
                      "type": "long",
                      "doc": "trials in the headline cell (NOT_TESTABLE: the largest trial count of the unit)"
                    },
                    {
                      "name": "effectBp",
                      "type": [
                        "null",
                        "int"
                      ],
                      "default": null,
                      "doc": "hit rate minus baseline in basis points of hit rate; null unless measured"
                    },
                    {
                      "name": "pAdjPpm",
                      "type": [
                        "null",
                        "int"
                      ],
                      "default": null,
                      "doc": "permutation-maximum adjusted p in parts per million; null unless measured"
                    },
                    {
                      "name": "calibrationFromDay",
                      "type": "int"
                    },
                    {
                      "name": "calibrationToDay",
                      "type": "int"
                    },
                    {
                      "name": "validationFromDay",
                      "type": "int"
                    },
                    {
                      "name": "validationToDay",
                      "type": "int"
                    },
                    {
                      "name": "datasetSha256",
                      "type": "string"
                    },
                    {
                      "name": "ledgerSha256",
                      "type": "string"
                    },
                    {
                      "name": "statement",
                      "type": "string",
                      "doc": "the fixed wording the chart shows verbatim, at most 300 bytes"
                    },
                    {
                      "name": "scaleStatement",
                      "type": "string",
                      "doc": "the measured time-scale evidence of the timeframe, at most 240 bytes"
                    }
                  ]
                }
              ],
              "default": null
            }
          ]
        }
      }
    }
  ]
}
