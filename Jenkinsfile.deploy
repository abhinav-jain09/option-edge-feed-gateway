// Deploy the feed-gateway as a host `java -jar` process on the local-mac dev agent.
//
// The gateway consumes the final display topics from Kafka and broadcasts them to the browser over an
// authenticated WebSocket (:8093). Previously it was hand-launched, so its runtime env (WS auth issuer,
// Kafka, port, origins) wasn't reproducible. This job makes the launch durable + main-only, mirroring the
// replay-orchestrator deploy: it builds the jar, then (re)starts the process with env sourced from an
// operator-maintained file (kept out of git), and fails closed if the WS isn't auth-gated.
pipeline {
  agent { label 'local-mac' }

  options {
    disableRestartFromStage()   // Deployment Permission Rule: no "Restart from Stage" past the permitted-commit guard
    disableConcurrentBuilds()
    skipDefaultCheckout(false)
  }

  parameters {
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: '2f6fc2ab7aa51eb8a9e8aa350f2d774cd2fb7a253de2591e43645a19a9886b24',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this definition runs (Deployment Permission Rule). The guard refuses to run under any other value. It is a DECLARATION, not proof that this job enforces the guard: a caller that triggers this job judges its SCM definition and its Jenkinsfile at the forwarded commit (scripts/jenkins/require-guarded-downstream.sh). Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    string(name: 'CONTRACTS_PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule. The full 40-character commit id of options-edge-contracts permitted for this restart: the Install Contracts stage clones contracts (main) and compiles that source into the jar, so it is bound on its own, before mvn install. Empty, short or mismatched values are refused and nothing is substituted.')
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before the jar is built or the process is restarted unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
  }

  environment {
    JAVA_HOME = '/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home'
    MAVEN_SKIP_RC = 'true'
    PATH = "${JAVA_HOME}/bin:/opt/homebrew/bin:/usr/bin:/bin:${env.PATH}"
    // Per-WORKSPACE Maven repository (artifact identity): the contracts jar this build installs must
    // be the one its packaging consumes; a shared ~/.m2 lets any other job overwrite it in between.
    MAVEN_OPTS = "-Dmaven.repo.local=${env.WORKSPACE}/.m2/repository"
    CONTRACTS_REPO = 'git@github.com:abhinav-jain09/options-edge-contracts.git'
    // Operator-maintained runtime env (out of git). See .env.dev.example / .env.prod.example for the keys.
    ENV_FILE = '/Users/abhinav/ci/config/feed-gateway.env'
    PID_FILE = '/Users/abhinav/ci/run/feed-gateway.pid'
    LOG_FILE = '/Users/abhinav/ci/logs/feed-gateway.log'
    HEALTH_PORT = '8093'
  }

  stages {
    stage('Checkout (main only)') {
      steps {
        sh '''
          set -euo pipefail
          reported_branch="${BRANCH_NAME:-${GIT_BRANCH:-}}"
          if [ -n "$reported_branch" ] && [ "$reported_branch" != "main" ] && [ "$reported_branch" != "origin/main" ] && [ "$reported_branch" != "*/main" ]; then
            echo "Deployment blocked: checked-out branch is '$reported_branch', only main is allowed." >&2
            exit 1
          fi
          git fetch --quiet origin main
          if ! git branch -r --contains "$(git rev-parse HEAD)" | sed 's/^[[:space:]]*//' | grep -Fx 'origin/main' >/dev/null; then
            echo "Deployment blocked: HEAD is not contained in origin/main." >&2
            exit 1
          fi
        '''
      }
    }

    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // SECOND, after the main-only checkout stage above, which stays as it was and keeps running first.
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the branch restriction again, as its own condition); a missing, empty,
    // short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a checked-out HEAD that
    // is not exactly PERMITTED_SHA. Before the contracts install, the package and the restart.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. Nothing was built or restarted.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }

    stage('Install Contracts') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        sh '''
          set -euo pipefail
          rm -rf .deps/options-edge-contracts
          git clone "$CONTRACTS_REPO" .deps/options-edge-contracts
          git -C .deps/options-edge-contracts checkout main
        '''
        // SECOND SOURCE, SECOND BINDING (Deployment Permission Rule): the contracts clone above is compiled in,
        // so it needs its own permitted commit — judged on that checkout, against CONTRACTS_PERMITTED_SHA, with
        // the selected ref judged as the literal name, BEFORE mvn install. A DEDICATED step whose whole script is
        // the guard command: the step fails if and only if the guard refuses (validator rule 9).
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${CONTRACTS_PERMITTED_SHA:-}" bash scripts/jenkins/permitted-sha-guard.sh --dir .deps/options-edge-contracts --ref main'
        }
        // PROVENANCE (Deployment Permission Rule, validator rule 9b): the verify re-proves, immediately before the contracts
        // source is compiled in, that its checkout is still exactly the permitted commit's tree, and the install is a
        // DEDICATED step whose whole body is the one mvn command — nothing can run between the verification and the
        // consumption.
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${CONTRACTS_PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir .deps/options-edge-contracts --allow-ignored target'
        }
        sh 'mvn -B -f .deps/options-edge-contracts/pom.xml install -DskipTests'
        sh '''
          set -euo pipefail
          # ARTIFACT IDENTITY, part 1: the installed contracts jar, by content — re-verified before
          # packaging and verified inside the packaged jar.
          CV="$(mvn -q -f .deps/options-edge-contracts/pom.xml help:evaluate -Dexpression=project.version -DforceStdout)"
          CJAR="$WORKSPACE/.m2/repository/com/optionsedge/options-edge-contracts/$CV/options-edge-contracts-$CV.jar"
          [ -f "$CJAR" ] || { echo "installed contracts jar not found at $CJAR" >&2; exit 1; }
          printf '%s\n' "$CV" > .contracts-version
          bash scripts/jenkins/permitted-sha-guard-version.sh "$CJAR" > .contracts-jar-sha256
          echo "contracts jar $CV sha256: $(cat .contracts-jar-sha256)"
        '''
      }
    }

    stage('Package') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        sh '''
          set -euo pipefail
          # ARTIFACT IDENTITY, part 2: the contracts jar about to be packaged in is still the bound one.
          CV="$(cat .contracts-version)"
          CJAR="$WORKSPACE/.m2/repository/com/optionsedge/options-edge-contracts/$CV/options-edge-contracts-$CV.jar"
          [ "$(bash scripts/jenkins/permitted-sha-guard-version.sh "$CJAR")" = "$(cat .contracts-jar-sha256)" ] \
            || { echo "the installed contracts jar changed since it was bound — refusing to package" >&2; exit 1; }
        '''
        // PROVENANCE (validator rule 9b): the gateway source is compiled into the jar this job launches, so the package is a
        // DEDICATED step right after the verify of the primary checkout (the declared ignored names are what this build
        // itself writes).
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir . --allow-ignored target --allow-ignored dev/raw-feed-replicator/target --allow-ignored .m2 --allow-ignored .deps --allow-ignored .jenkins-tmp --allow-ignored .contracts-sha --allow-ignored .contracts-version --allow-ignored .contracts-jar-sha256 --allow-ignored .jar-sha256 --allow-ignored scripts/__pycache__ --allow-ignored scripts/jenkins/__pycache__'
        }
        sh 'mvn -B clean package -DskipTests'
        sh '''
          set -euo pipefail
          # part 3: the packaged jar, by content, and the contracts jar INSIDE it.
          JAR="$(find target -maxdepth 1 -type f -name 'options-edge-feed-gateway-*.jar' ! -name '*.original' | sort | head -n1)"
          [ -n "$JAR" ] || { echo "no packaged gateway jar under target/" >&2; exit 1; }
          bash scripts/jenkins/permitted-sha-guard-version.sh "$JAR" > .jar-sha256
          bash scripts/jenkins/verify-embedded-contracts.sh "$JAR" "$(cat .contracts-jar-sha256)"
        '''
      }
    }

    stage('Deploy') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        sh '''
          set -euo pipefail
          mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")"

          jar="$(find target -maxdepth 1 -type f -name 'options-edge-feed-gateway-*.jar' ! -name '*.original' | sort | head -n1)"
          [ -n "$jar" ] || { echo "Deploy failed: no gateway jar under target/." >&2; exit 1; }
          # ARTIFACT IDENTITY, part 4: the jar about to be launched is the one packaged and verified.
          [ "$(bash scripts/jenkins/permitted-sha-guard-version.sh "$jar")" = "$(cat .jar-sha256)" ] \
            || { echo "the packaged jar changed since it was verified — refusing to launch" >&2; exit 1; }
          bash scripts/jenkins/verify-embedded-contracts.sh "$jar" "$(cat .contracts-jar-sha256)"
          echo "Launching $jar (sha256 $(cat .jar-sha256))"

          # Load the runtime env (WS auth issuer/audience/origins, Kafka, port). Out of git; see .env.*.example.
          if [ -f "$ENV_FILE" ]; then
            set -a; . "$ENV_FILE"; set +a
          else
            echo "WARNING: $ENV_FILE not found — the gateway will fall back to code defaults (likely wrong for this env)." >&2
          fi

          # Stop the previous instance: by pid file, then by whatever still holds the port.
          if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            kill "$(cat "$PID_FILE")" 2>/dev/null || true
          fi
          old="$(lsof -nP -iTCP:${HEALTH_PORT} -sTCP:LISTEN -t 2>/dev/null || true)"
          [ -n "$old" ] && { kill $old 2>/dev/null || true; }
          for i in $(seq 1 15); do lsof -nP -iTCP:${HEALTH_PORT} -sTCP:LISTEN -t >/dev/null 2>&1 && sleep 1 || break; done
          lsof -nP -iTCP:${HEALTH_PORT} -sTCP:LISTEN -t >/dev/null 2>&1 && { kill -9 $(lsof -nP -iTCP:${HEALTH_PORT} -sTCP:LISTEN -t) 2>/dev/null || true; sleep 1; }

          # Detach so the process survives the Jenkins build (BUILD_ID/JENKINS_NODE_COOKIE=dontKillMe).
          export BUILD_ID=dontKillMe
          export JENKINS_NODE_COOKIE=dontKillMe
          nohup "$JAVA_HOME/bin/java" -jar "$jar" >"$LOG_FILE" 2>&1 &
          echo $! > "$PID_FILE"
          echo "feed-gateway started, pid $(cat "$PID_FILE")"

          # Liveness: the gateway serves the root.
          deadline=$((SECONDS + 90)); healthy=0
          while [ "$SECONDS" -lt "$deadline" ]; do
            if curl -fsS --max-time 5 "http://localhost:${HEALTH_PORT}/" >/dev/null 2>&1; then healthy=1; break; fi
            if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then echo "gateway exited before becoming healthy" >&2; tail -n 120 "$LOG_FILE" || true; exit 1; fi
            sleep 2
          done
          [ "$healthy" = "1" ] || { echo "gateway did not become healthy" >&2; tail -n 120 "$LOG_FILE" || true; exit 1; }

          # Fail closed: the WS endpoint MUST reject an unauthenticated client when WS auth is enabled.
          if [ "${WS_AUTH_ENABLED:-false}" = "true" ]; then
            code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://localhost:${HEALTH_PORT}/ws/events" || echo 000)"
            if [ "$code" != "401" ]; then
              echo "SECURITY GATE FAILED: /ws/events returned $code without a token (expected 401)." >&2
              kill "$(cat "$PID_FILE")" 2>/dev/null || true
              exit 1
            fi
            echo "Security gate OK: /ws/events returns 401 without a token."
          fi
          echo "Deployed feed-gateway -> http://localhost:${HEALTH_PORT}/ (Kafka=${KAFKA_ENABLED:-?}, issuer=${WS_AUTH_ISSUER_URI:-?})"
        '''
      }
    }
  }
}
